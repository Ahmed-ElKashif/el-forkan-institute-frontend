# Base URL of the El Forkan API (backend/). The API's own PORT defaults to 3000,
# and its CORS_ORIGIN already allows this dev server on :5173.
#
# In production this is baked into the bundle at build time and points at the
# deployed API's origin (no trailing slash) — set it in Render, not here. See
# DEPLOY.md.
VITE_API_BASE_URL=http://localhost:3000
